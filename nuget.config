<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-lokal: nur nuget.org. Überschreibt globale Feeds (private Azure-DevOps-Feeds
     der Maschine sind hier nicht erreichbar und würden Restore mit 401 brechen). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
